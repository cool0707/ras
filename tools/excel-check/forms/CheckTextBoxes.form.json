      "specialEffect": 0,
      "backStyle": 0
    },
    {
      "id": "t6",
      "name": "txtRaised",
      "type": "TextBox",
      "left": 112,
      "top": 60,
      "width": 100,
      "height": 18,
      "text": "Raised",
      "specialEffect": 1
    },
    {
      "id": "t7",
      "name": "txtEtched",
      "type": "TextBox",
      "left": 218,
      "top": 60,
      "width": 100,
      "height": 18,
      "text": "Etched",
      "specialEffect": 3
    },
    {
      "id": "t8",
      "name": "txtBump",
      "type": "TextBox",
      "left": 6,
      "top": 84,
      "width": 100,
      "height": 18,
      "text": "Bump",
      "specialEffect": 6
    },
    {
      "id": "t9",
      "name": "txtBorder",
      "type": "TextBox",
      "left": 112,
      "top": 84,
      "width": 100,
      "height": 18,
