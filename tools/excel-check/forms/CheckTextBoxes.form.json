      "enterFieldBehavior": 1,
      "autoTab": true,
      "maxLength": 5,
      "autoWordSelect": false,
      "hideSelection": false,
      "selectionMargin": false,
      "integralHeight": false,
      "dragBehavior": 1,
      "imeMode": 4
