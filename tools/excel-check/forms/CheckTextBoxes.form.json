{
  "schemaVersion": 1,
  "kind": "ras.userform",
  "basis": "designer",
  "form": {
    "name": "CheckTextBoxes",
    "caption": "TextBox の確認",
    "width": 330,
    "height": 230
  },
  "controls": [
    {
      "id": "t1",
      "name": "txtPlain",
      "type": "TextBox",
      "left": 6,
      "top": 6,
      "width": 100,
      "height": 18,
      "text": "既定"
    },
    {
      "id": "t2",
      "name": "txtMulti",
      "type": "TextBox",
      "left": 112,
      "top": 6,
      "width": 100,
      "height": 48,
      "text": "複数行の\r\nテキスト\r\n3 行目",
      "multiLine": true,
      "scrollBars": 2,
      "enterKeyBehavior": true,
      "tabKeyBehavior": true,
      "wordWrap": false,
      "locked": true
    },
    {
      "id": "t3",
      "name": "txtPassword",
      "type": "TextBox",
      "left": 218,
      "top": 6,
      "width": 100,
      "height": 18,
