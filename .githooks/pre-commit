#!/bin/sh
# Runs `cargo fmt --all` before a commit and re-stages the .rs files that were staged.
# For git: `git config core.hooksPath .githooks`. Claude Code calls it from .claude/settings.json.
cd "$(git rev-parse --show-toplevel)" || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
if ! cargo fmt --all; then
  echo "pre-commit: cargo fmt failed" >&2
  exit 2
fi
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | while IFS= read -r f; do git add -- "$f"; done
fi
exit 0
