        xlThemeColorAccent5 = 9,
        xlThemeColorAccent6 = 10,
        xlThemeColorDark1 = 1,
        xlThemeColorDark2 = 3,
        xlThemeColorFollowedHyperlink = 12,
        xlThemeColorHyperlink = 11,
        xlThemeColorLight1 = 2,
        xlThemeColorLight2 = 4
    }

    /**
     * テーマのフォントを指定する。
     * @see https://learn.microsoft.com/office/vba/api/excel.xlthemefont
     */
    enum XlThemeFont {
        xlThemeFontMajor = 1,
        xlThemeFontMinor = 2,
        xlThemeFontNone = 0
    }

    /**
     * Application.International で取得する国や地域の設定項目を指定する。
     * @see https://learn.microsoft.com/office/vba/api/excel.xlapplicationinternational
     */
    enum XlApplicationInternational {
        xl24HourClock = 33,
        xl4DigitYears = 43,
        xlAlternateArraySeparator = 16,
        xlColumnSeparator = 14,
        xlCountryCode = 1,
        xlCountrySetting = 2,
        xlCurrencyBefore = 37,
        xlCurrencyCode = 25,
        xlCurrencyDigits = 27,
        xlCurrencyLeadingZeros = 40,
        xlCurrencyMinusSign = 38,
        xlCurrencyNegative = 28,
        xlCurrencySpaceBefore = 36,
        xlCurrencyTrailingZeros = 39,
        xlDateOrder = 32,
        xlDateSeparator = 17,
        xlDayCode = 21,
        xlDayLeadingZero = 42,
        xlDecimalSeparator = 3,
        xlGeneralFormatName = 26,
        xlHourCode = 22,
        xlLeftBrace = 12,
        xlLeftBracket = 10,
        xlListSeparator = 5,
        xlLowerCaseColumnLetter = 9,
        xlLowerCaseRowLetter = 8,
        xlMDY = 44,
        xlMetric = 35,
        xlMinuteCode = 23,
        xlMonthCode = 20,
        xlMonthLeadingZero = 41,
        xlMonthNameChars = 30,
        xlNoncurrencyDigits = 29,
        xlNonEnglishFunctions = 34,
        xlRightBrace = 13,
        xlRightBracket = 11,
        xlRowSeparator = 15,
        xlSecondCode = 24,
        xlThousandsSeparator = 4,
        xlTimeLeadingZero = 45,
        xlTimeSeparator = 18,
        xlUpperCaseColumnLetter = 7,
        xlUpperCaseRowLetter = 6,
        xlWeekdayNameChars = 31,
        xlYearCode = 19
    }
}

// ---------------------------------------------------------------------
// 修飾なしで使えるグローバル（VBA の Excel グローバルと同じ）
// ---------------------------------------------------------------------

/**
 * Excel アプリケーション本体。
 * @see https://learn.microsoft.com/office/vba/api/excel.application(object)
 */
declare const Application: Excel.Application;

/**
 * 実行中のマクロが入っているブック。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.thisworkbook
 */
declare const ThisWorkbook: Excel.Workbook;

/**
 * アクティブなブック。ブックが開いていなければ Nothing。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.activeworkbook
 */
declare const ActiveWorkbook: Excel.Workbook;

/**
 * アクティブなシート（ワークシートまたはグラフ シート）。ブックが開いていなければ Nothing。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.activesheet
 */
declare const ActiveSheet: Excel.Worksheet | Excel.Chart;

/**
 * アクティブなセル。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.activecell
 */
declare const ActiveCell: Excel.Range;

/**
 * アクティブなウィンドウ。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.activewindow
 */
declare const ActiveWindow: Excel.Window;

/**
 * 現在選択されているオブジェクト。Object 型。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.selection
 */
declare const Selection: object;

/**
 * 開いているすべてのブックのコレクション。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.workbooks
 */
declare const Workbooks: Excel.Workbooks;

/**
 * アクティブ ブックのすべてのワークシート。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.worksheets
 */
declare const Worksheets: Excel.Sheets<Excel.Worksheet>;

/**
 * アクティブ ブックのすべてのシート（グラフ シートを含む）。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.sheets
 */
declare const Sheets: Excel.Sheets;

/**
 * アクティブ ブックの名前定義のコレクション。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.names
 */
declare const Names: Excel.Names;

/**
 * すべてのウィンドウのコレクション。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.windows
 */
declare const Windows: Excel.Windows;

/**
 * ワークシート関数を VBA から呼び出すためのオブジェクト。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.worksheetfunction
 */
declare const WorksheetFunction: Excel.WorksheetFunction;

/**
 * アクティブ シート上のセルまたはセル範囲を返す。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.range
 */
declare function Range(cell1: any, cell2?: any): Excel.Range;

/**
 * アクティブ シートのセルを返す。引数なしなら全セル。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.cells
 */
declare function Cells(row?: any, col?: any): Excel.Range;

/**
 * アクティブ シートの行を返す。引数なしなら全行。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.rows
 */
declare function Rows(index?: any): Excel.Range;

/**
 * アクティブ シートの列を返す。引数なしなら全列。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.columns
 */
declare function Columns(index?: any): Excel.Range;

/**
 * 複数のセル範囲を 1 つにまとめた範囲を返す。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.union
 */
declare function Union(arg1: Excel.Range, arg2: Excel.Range, arg3?: any, arg4?: any, arg5?: any, arg6?: any, arg7?: any, arg8?: any, arg9?: any, arg10?: any): Excel.Range;

/**
 * 複数のセル範囲の共通部分を返す。重なりがなければ Nothing。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.intersect
 */
declare function Intersect(arg1: Excel.Range, arg2: Excel.Range, arg3?: any, arg4?: any, arg5?: any, arg6?: any, arg7?: any, arg8?: any, arg9?: any, arg10?: any): Excel.Range;

/**
 * 名前や数式の文字列を評価して、オブジェクトまたは値にする。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.evaluate
 */
declare function Evaluate(name: any): any;

/**
 * マクロまたは関数を名前で呼び出す。
 * @see https://learn.microsoft.com/office/vba/api/excel.application.run
 */
declare function Run(macro: any, arg1?: any, arg2?: any, arg3?: any, arg4?: any, arg5?: any, arg6?: any, arg7?: any, arg8?: any, arg9?: any, arg10?: any): any;
