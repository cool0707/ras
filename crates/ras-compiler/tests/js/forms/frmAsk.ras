// `new frmAsk(...)` / `showModal()` / `this.close(value)` (spec §14.11.9).
let question = "";
let asked = 0;
/** 他のモジュールから `frmAsk.note` / `f.note` で読み書きできる（インスタンスごと）。 */
export let note = "none";

function constructor(q: string, initial: string = "") {
    question = q;
    this.caption = q;
    this.txtAnswer.text = initial;
}

@on("UserForm.Activate")
function shown() {
    asked++;
    console.log(`asking ${question} (${asked})`);
}

@on("btnOK.Click")
function ok() {
    this.close(`${question}=${this.txtAnswer.text}`);
}

@on("btnCancel.Click")
function cancel() {
    this.close();
}

@on("UserForm.Terminate")
function bye() {
    console.log(`bye ${question}`);
}

export function describe(): string {
    return `${question}/${asked}`;
}
