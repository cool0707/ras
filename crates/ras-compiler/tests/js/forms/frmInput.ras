let opened = 0;
let agreed = 0;
let firstSpin: RAS_Listener = null;

@on("UserForm.Initialize")
function init() {
    opened++;
    this.caption = `入力 ${opened}`;
    this.cboKind.addItem("予約", 1);
    // Handlers attached at run time (spec §12.2.3): called after the `@on` handlers.
    this.chkAgree.on("Click", () => {
        agreed++;
        console.log(`agree ${this.chkAgree.value} ${agreed}`);
    });
    firstSpin = this.spnQty.addEventListener("SpinUp", spunOnce);
    for (const c of this.controls) {
        if (c instanceof MSForms.CommandButton) c.on("Click", () => console.log(`clicked ${c.name}`));
    }
}

function spunOnce() {
    console.log("first spin");
    firstSpin.off();
}

@on("txtName.Change")
function upper() {
    // Re-entering the handler through its own change is ignored (spec §14.11.2).
    this.txtName.text = this.txtName.text.toUpperCase();
}

@on("txtName.Exit")
function leave(cancel: MSForms.ReturnBoolean) {
    cancel.value = this.txtName.text == "NG";
}

@on("optM.Change")
function sized() {
    console.log(`optS=${this.optS.value} optM=${this.optM.value}`);
}

@on("chkMaybe.Change")
function maybe() {
    console.log(`maybe=${this.chkMaybe.value == null ? "Null" : this.chkMaybe.value}`);
}

@on("spnQty.SpinUp")
function up() {
    console.log(`up ${this.spnQty.value}`);
}

@on("btnBoom.Click")
function boom() {
    const xs: int[] = [];
    console.log(xs[3]);
}

@on("btnOK.Click")
function ok() {
    this.hide();
}

@on("UserForm.QueryClose")
function closing(byref cancel: short, closeMode: short) {
    console.log(`QueryClose mode=${closeMode}`);
    if (closeMode == vbFormControlMenu) cancel = 1;
}

@on("UserForm.Terminate")
function bye() {
    console.log("Terminate");
}

export function summary(): string {
    return `${this.txtName.text}/${this.cboKind.text}:${this.cboKind.listIndex}/${this.cboKind.listCount}/${this.chkAgree.value}/${this.spnQty.value}/${opened}/${this.lstStaff.value}:${this.lstStaff.text}:${this.lstStaff.list(0, 1)}/${this.tag}:${this.zoom}`;
}
