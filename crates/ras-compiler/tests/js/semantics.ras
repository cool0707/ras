import { clamp, Counter } from "src/lib";

enum Color { Red, Green = 5, Blue }
interface Shape { area(): double; }
class Circle implements Shape {
    private r: double;
    constructor(r: double) { this.r = r; }
    area(): double { return Math.PI * this.r * this.r; }
    get radius(): double { return this.r; }
}
struct Point { x: int; y: int; }
struct Pt { x: int; y: int; tag?: string; }
function label(a: int, b: int = 2, c: string = "x"): string { return `${a}/${b}/${c}`; }
function bump(byref n: int, by: int = 1): void { n += by; }

function mkPt(x: int, y: int): Pt {
    return { x, y };
}

function divmod(a: int, b: int): [int, int] {
    return [a / b, a % b];
}

function sumX(ps: Pt[]): int {
    let s = 0;
    for (const p of ps) s += p.x;
    return s;
}

function swap(byref a: int, byref b: int) {
    const t = a;
    a = b;
    b = t;
}

function sum(xs: int[]): int {
    let s = 0;
    for (const x of xs) s += x;
    return s;
}

function joinAll(head: string, sep: string = "-", ...parts: any[]): string {
    parts.push("end");
    return `${head}${parts.length}:${parts.join(sep)}`;
}

class Bag {
    all: any[];
    constructor(first: int, ...more: any[]) {
        this.all = more;
        this.all.push(first);
    }
    add(...more: any[]): int {
        for (const m of more) this.all.push(m);
        return this.all.length;
    }
}

function describe(c: Color): string {
    switch (c) {
        case Color.Red: return "red";
        case Color.Green:
        case Color.Blue: return "cool";
        default: return "?";
    }
}

export function run() {
    let a = 1;
    let b = 2;
    swap(a, b);
    console.log("swap", a, b);
    const xs = [3, 1, 2];
    const ys = xs;
    ys[0] = 99;
    console.log("copy", xs[0], ys[0], sum(xs));
    const doubled = xs.map(x => x * 2).filter(x => x > 2);
    console.log("map", doubled.join("-"), doubled.length);
    xs.sort();
    console.log("sort", xs.join(","));
    console.log("div", 7 / 2, 7.0 / 2, -7 / 2, 7 % 3, 2 ** 10);
    console.log("str", `x=${0.1 + 0.2} y=${1.5} z=${true} n=${100000000000000000000.0}`);
    const c = new Circle(2);
    console.log("class", c.area().toFixed(3), c.radius, c instanceof Circle, describe(Color.Blue), Color.Green);
    let p: Point;
    p.x = 3;
    let q = p;
    q.x = 4;
    console.log("struct", p.x, q.x);
    const m = new Map<string, int>();
    m.set("a", 1);
    m.set("b", 2);
    console.log("map", m.get("a"), m.get("zz"), m.has("b"), m.size, m.keys().join(""));
    try {
        const z = 0;
        console.log(1 / z);
    } catch (e) {
        console.log("caught", e.code, e.description);
    }
    try {
        throw new Error("boom", 1234);
    } catch (e) {
        console.log("caught", e.code, e.message);
    } finally {
        console.log("finally");
    }
    try {
        let big = 2147483647;
        big = big + 1;
    } catch (e) {
        console.log("overflow", e.code);
    }
    try {
        console.log(xs[10]);
    } catch (e) {
        console.log("oob", e.code);
    }
    let n = 0;
    try { n = 1; throw "skipped"; n = 2; } catch { resume; }
    console.log("resume", n);
    const cnt = new Counter();
    cnt.inc(); cnt.inc();
    console.log("counter", cnt.value, clamp(15, 0, 10), clamp(-5, 0, 10));
    let i = 0;
    outer: while (true) {
        for (let j = 0; j < 10; j++) {
            i++;
            if (i >= 7) break outer;
        }
    }
    console.log("loop", i, "abc".toUpperCase(), "  hi ".trim() + "!", "a,b,c".split(",").length, "hello".substring(1, 3), "x".padStart(3, "0"));
    console.log("conv", 3.7 as int, (-3.7) as int, Math.round(2.5), Math.round(-2.5), parseInt("42px"), (5 > 3) as int);
    let pts: Pt[] = [];
    for (let k = 1; k <= 3; k++) pts.push({ x: k, y: k * 10, tag: "t" + k.toString() });
    const { x: px, y: py } = mkPt(4, 5);
    const [dq, dr] = divmod(17, 5);
    let acc = 0;
    for (const { x, y } of pts) acc += x * y;
    for (const p of pts) {
        let c = p;
        c.x = 100;
        acc += c.x - p.x;
    }
    const anon = { name: "n", n: 2 };
    let sw: Pt = { x: 1, y: 2 };
    sw = { x: sw.y, y: sw.x };
    const pm = new Map<string, Pt>();
    pm.set("a", pts[0]);
    pm.set("b", { x: 9, y: 8 });
    pm.delete("a");
    pm.set("c", pts[2]);
    console.log("struct2", sumX(pts), px, py, dq, dr, acc, anon.name, anon.n, sw.x, sw.y, pts[0].tag);
    console.log("structmap", pm.size, pm.has("a"), pm.get("b").x, pm.get("zz").y, pm.keys().join(""), pm.values().length, pm.get("c").tag);
    let k = 1;
    bump(by: 5, n: k);
    console.log("named", label(a: 123, c: "あいう"), label(1, c: "z"), label(c: "q", b: 7, a: 0), new Circle(r: 1).radius, k);
    // Error values (#N/A): a kind of their own in a union, null after Excel.errorToNull, a type mismatch for `==` on `any`.
    const na = cvErr(2042);
    const ue: string | double = Excel.errorToNull(na) ?? 1;
    let ve: string | double = 1;
    ve = na;
    const withErr: any[] = [];
    withErr.push(1);
    withErr.push(na);
    withErr.push("a");
    const cleaned = Excel.errorToNull(withErr);
    let mismatch = 0;
    try {
        if (na == 1) mismatch = -1;
    } catch (e) {
        mismatch = e.code;
    }
    console.log("errval", ue, ve == "x", ve == 1, ve == cvErr(2042), ve == cvErr(2007), cleaned[1] == null, cleaned[2], mismatch);
    // Ranges and positions from the end (spec §4.5): ends are kept within the array, negative ends are 0.
    const rg = [10, 20, 30, 40, 50];
    let rb = [1, 2, 3, 4];
    rb[^1] = 99;
    rb[^2] += 5;
    rb = rb[1..];
    const rs = "abcdef";
    let rsum = 0;
    for (const i of 1..rg.length) rsum += i;
    for (let i of 0..3) { i = i * 10; rsum += i; }
    const rm = new Array<int>(2, 3);
    rm[^1][^1] = 7;
    const rps: Pt[] = [mkPt(1, 2), mkPt(3, 4), mkPt(5, 6)];
    const rq = rps[1..];
    rq[0].x = 100;
    console.log("range", rg[^1], rg[1..^1].join(), rg[..2].join(), rg[-3..2].join(), rg[3..1].length, rg[^9..^3].join(), rb.join(), rs[^1], rs[1..3], rs[..^2], rs[4..99], rs[5..2], rsum, rm[1][2], rm[^2][0], rps[1].x, rq[0].x);
    console.log("step", rg.step(2).join(), rg[1..].step(2).join(), rg.toReversed().join(), rg.join(), rps.toReversed()[0].x, rps.step(2).length);
    // `transpose()` swaps rows and columns into a new 2-D array; no columns gives an empty array.
    const tm = new Array<int>(2, 3);
    tm[0][2] = 5;
    tm[1][0] = 7;
    const tt = tm.transpose();
    tt[0][0] = 9;
    console.log("transpose", tt.rows, tt.cols, tt[2][0], tt[0][1], tm[0][0], tt.transpose()[1][0], new Array<string>(0, 0).transpose().rows);
    // Rest parameters (spec §3.5): the extra arguments as a 0-based `any[]`, empty without them.
    const sack = new Bag(1, "a", 2.5);
    console.log("rest", joinAll("h"), joinAll("", "+", 1, "b", true), joinAll("", sep: "/"), sack.add(), sack.add(9, null), sack.all.join());
    // `like` is VBA's `Like` (binary comparison): `?`, `*`, `#`, `[list]`, `[!list]`.
    console.log("like", like("abc", "a*"), like("abc", "A*"), like("a1c", "a#c"), like("abc", "a?c"), like("abc", "a[a-c]c"), like("abc", "a[!a-c]c"), like("a*c", "a[*]c"), like("", "*"), like("ab", "a"), like("x.y", "x.y"), like("xzy", "x.y"));
    // `dbNull` is VBA's `Null`: not `Empty`, but no value for `== null` and `??` either.
    const dn: any = dbNull;
    const en: any = null;
    console.log("dbnull", isNull(dn), isNull(en), isEmpty(dn), isEmpty(en), dn == null, en == null, typeName(dn), varType(dn), dn ?? "d", isNull(dbNull), `[${dn}]`);
    // An event of a class (spec §12.2.2): the handlers of the fields that hold the object run.
    const gong = new Bell();
    const near = new Listener(gong);
    const far = new Listener(new Bell());
    console.log("event", gong.ring(2), gong.ring(3), near.total, far.total);
}

class Bell {
    event Rang(times: int, byref heard: int);

    ring(times: int): int {
        let heard = 0;
        this.Rang(times, heard);
        return heard;
    }
}

class Listener {
    private source: Bell;
    total = 0;

    constructor(from: Bell) {
        this.source = from;
    }

    @on("source.Rang")
    private heardIt(times: int, byref heard: int) {
        this.total += times;
        heard++;
    }
}
