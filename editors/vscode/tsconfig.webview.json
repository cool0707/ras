{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["webview/**/*.ts", "webview/**/*.tsx", "webview/**/*.d.ts"]
}
